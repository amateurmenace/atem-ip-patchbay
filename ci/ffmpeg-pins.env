# CI pins for the self-built FFmpeg+DeckLink sidecar.
#
# Bumping any value here triggers .github/workflows/build-ffmpeg.yml
# via paths-filter. The build outputs (ffmpeg / ffmpeg.exe) are
# uploaded to a private prerelease in this repo with tag
#   ffmpeg-decklink-${FFMPEG_VERSION}-bmd${BMD_SDK_VERSION}-rev${BUILD_REVISION}
# which release.yml's tag-build then downloads via `gh release download`
# instead of the previous jellyfin / gyan.dev curl steps.
#
# WHY THIS EXISTS:
# - Both prebuilt FFmpeg distros for Windows (BtbN, gyan.dev) and
#   Mac (jellyfin-ffmpeg) historically dropped `--enable-decklink`
#   because the Blackmagic DeckLink SDK has redistribution terms
#   that prohibit shipping prebuilt FFmpeg binaries against it.
# - alpha.21 added DeckLink-output destinations to the app, but the
#   shipped installers still bundle a decklink-less FFmpeg — so the
#   feature is non-functional out of the box.
# - This pipeline builds OUR OWN FFmpeg, linked against the SDK we
#   download (once, manually, EULA-accepted) from Blackmagic and
#   mirror to a private repo. The shipped FFmpeg has `--enable-
#   decklink`; the DeckLink runtime driver still has to be installed
#   on the end-user's machine (free download from blackmagicdesign.com).
#
# SETUP: see docs/SETUP-FFMPEG-CI.md for the one-time SDK mirror
# + BMD_SDK_PAT secret setup. Until that's done, this pin file
# exists but no FFmpeg sidecar release is produced — release.yml's
# main app build keeps using jellyfin / gyan.dev with a decklink-
# less FFmpeg (the existing path).

# FFmpeg upstream release tag (https://github.com/FFmpeg/FFmpeg/tags).
# Bumping rebuilds. Pinned to match what gyan.dev's Windows
# full_build was as of alpha.22 (8.1.1) — confirmed compatible with
# our DeckLink command surface.
FFMPEG_VERSION=n8.1.1

# Blackmagic DeckLink SDK version. Must match the asset filename
# uploaded to amateurmenace/bmd-decklink-sdk-mirror (e.g. the v14.4
# release ships Blackmagic_DeckLink_SDK_14.4.zip). 14.4 is the
# current LTS — ABI-compatible with Desktop Video 12.0+ which is
# what most operator machines have installed.
BMD_SDK_VERSION=14.4

# Increment this to force a rebuild without changing FFmpeg or SDK
# version (e.g. configure flag changes, toolchain bumps, sanity-
# check additions). Starts at 1; bump on each configure-time change.
BUILD_REVISION=1
